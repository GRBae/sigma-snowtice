  "rules": [
    {"id": "rule:grad:basic", "applies_to": "tmpl:grad", "src": "static:graduate01",
     "tree": {"AND": [
        {"attr": "semesters_registered", "op": ">=", "value": 8, "note": "약대는 12학기"},
        {"attr": "enroll_status", "op": "in", "value": ["재학", "수료"], "evidence": "휴학생 불가"},
        {"attr": "other", "text": "학번 및 전공별 졸업학점 이수 (졸업학점배정표 첨부)", "evidence": "학번 및 전공별 졸업학점"},
        {"OR": [
          {"AND": [{"attr": "admission_year", "op": ">=", "value": 2011}, {"attr": "gpa_total", "op": ">=", "value": 1.7}]},
          {"AND": [{"attr": "admission_year", "op": "<=", "value": 2010}, {"attr": "gpa_total", "op": ">=", "value": 1.5}]}
        ], "evidence": "총 평점평균 1.7/4.3 이상"},
        {"OR": [
          {"AND": [{"attr": "admission_year", "op": "between", "value": [2001, 2019]}, {"attr": "cert_thesis_passed", "op": "==", "value": true}, {"attr": "cert_info_passed", "op": "==", "value": true}]},
          {"AND": [{"OR": [{"attr": "admission_year", "op": ">=", "value": 2020}, {"attr": "admission_year", "op": "<=", "value": 2000}]}, {"attr": "cert_thesis_passed", "op": "==", "value": true}]}
        ], "evidence": "졸업논문제 + 정보인증제 통과"}
     ]}},
    {"id": "rule:thesis-apply", "applies_to": "stg:grad:2026-2:04", "src": "main:95274",
     "tree": {"OR": [
        {"AND": [{"attr": "enroll_status", "op": "==", "value": "재학"}, {"attr": "credits_completed", "op": ">=", "value": {"lookup": "third_year_credits", "by": ["admission_year", "field"]}}]},
        {"AND": [{"attr": "enroll_status", "op": "==", "value": "수료"}, {"attr": "cert_thesis_passed", "op": "==", "value": false}]}
     ]},
     "lookup_tables": {"third_year_credits": [
        {"admission_year": "<=2011", "field": "*", "value": 105},
        {"admission_year": "2012-2014", "field": "*", "value": 101},
        {"admission_year": ">=2015", "field": "인문사회", "value": 94},
        {"admission_year": ">=2015", "field": "자연과학|공학|예체능", "value": 98}
     ], "note": "약학대학·학사편입생 기준은 별도 (원문 표 참조)"},
     "evidence": [{"src": "main:95274", "quote": "① 3학년(약학대학은 5학년) 수료학점 이상 이수 완료한 재학생"}]},
    {"id": "rule:math-exam", "applies_to": "proc:math-thesis:2026-2", "src": "math:146958",
     "tree": {"AND": [
        {"OR": [{"attr": "dept", "op": "==", "value": "dept:math"}, {"attr": "second_major", "op": "==", "value": "dept:math"}]},
        {"attr": "semesters_registered", "op": ">=", "value": 7, "note": "7학기 이상 수료, 휴학생·휴학예정자 포함"}
     ]},
     "subjects": ["복소수함수론", "추상대수학", "미분기하학"],
     "exemption": {"status": "U", "reason": "면제 조건이 첨부 PDF '수학과 졸업요건 및 졸업시험 범위'에만 있음 → 첨부 추출 후 채움"},
     "evidence": [{"src": "math:146958", "quote": "대상자: 수학전공, 수학복수전공 학생 중 7학기 이상 수료한 학생(휴학생, 휴학예정자 포함)"}]},
    {"id": "rule:early:honors", "applies_to": "proc:early-grad:2026-2", "src": "main:94717",
     "tree": {"AND": [
        {"attr": "semesters_registered", "op": "in", "value": [6, 7]},
        {"attr": "gpa_each_term", "op": ">=", "value": 3.9},
        {"attr": "gpa_total", "op": ">=", "value": 3.9},
        {"attr": "other", "text": "졸업기준학점 취득 완료 예정(2026-2 및 겨울계절 신청학점 포함)"},
        {"attr": "other", "text": "졸업인증제 전체 합격 예정"},
        {"attr": "transfer_type", "op": "==", "value": "없음"}
     ]},
     "evidence": [{"src": "main:94717", "quote": "가) 2026-2학기 기준 6~7학기 재학생"}]},
    {"id": "rule:early:bsms", "applies_to": "proc:early-grad:2026-2", "src": "main:94717",
